# Copy to ~/.config/obs-demo/env (or set OBS_DEMO_ENV). chmod 600. Do NOT commit.
OBS_MGMT_HOST=192.168.1.31
OBS_MGMT_PORT=4443
OBS_MGMT_USER=root
OBS_MGMT_PASS=<management-password>
OBS_S3_HTTP=http://192.168.1.31:9020
OBS_S3_HTTPS=https://192.168.1.31:9021
OBS_S3_USER=demo-s3user
OBS_S3_NAMESPACE=ns1
OBS_S3_ACCESS_KEY=<object-user-name>
OBS_S3_SECRET_KEY=<generated-secret-key>
